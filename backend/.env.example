MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aussieeats
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Server-only Places key for Mongo catalog ingest (`npm run db:import-places`
# / `python3 -m app.import_places`). Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# from the repo-root .env if unset. Enable the legacy Places API.
GOOGLE_PLACES_API_KEY=
