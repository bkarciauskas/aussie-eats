MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aussieeats
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Set GOOGLE_PLACES_API_KEY in the repo-root .env (not here). An empty
# GOOGLE_PLACES_API_KEY= in this file would overwrite the root value when the
# ingest loader applies backend/.env with override=True.
