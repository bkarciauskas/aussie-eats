generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  /// CUSTOMER | ADMIN
  role         String    @default("CUSTOMER")
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  favourites   Favourite[]
}

model Address {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  line1    String
  suburb   String
  state    String  @default("NSW")
  postcode String
  lat      Float?
  lng      Float?
}

model Restaurant {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  description      String
  image            String
  cuisineTags      String
  /// JSON string array of diet tags present on the menu (demo approximation)
  dietaryTags      String     @default("[]")
  city             String     @default("Sydney")
  suburb           String
  lat              Float
  lng              Float
  deliveryFeeCents Int
  minOrderCents    Int
  isOpen           Boolean    @default(true)
  isActive         Boolean    @default(true)
  rating           Float      @default(4.5)
  /// Google Places place id; upsert key for catalog ingest
  placeId          String?    @unique
  userRatingCount  Int        @default(0)
  /// Serialized Places regularOpeningHours JSON
  openingHoursJson String?
  phone            String?
  categories       Category[]
  orders           Order[]
  reviews          Review[]
  favourites       Favourite[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Favourite {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId, createdAt])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceCents  Int
  image       String?
  isAvailable Boolean     @default(true)
  /// JSON string array: vegan | vegetarian | gluten-free | halal | nut-free
  dietaryTags String      @default("[]")
  /// JSON string array of known allergens (e.g. peanuts, tree-nuts); empty ≠ safe
  allergens   String      @default("[]")
  orderItems  OrderItem[]
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  restaurantId     String
  restaurant       Restaurant  @relation(fields: [restaurantId], references: [id])
  /// pending | preparing | out_for_delivery | delivered | cancelled
  status           String      @default("pending")
  /// JSON array of { status, at } status transitions
  statusHistoryJson String     @default("[]")
  subtotalCents    Int
  deliveryFeeCents Int
  totalCents       Int
  deliveryAddress  String
  paymentMethod    String      @default("Pay on delivery")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
  review           Review?
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int
}

model Review {
  id           String     @id @default(cuid())
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// 1–5 star rating
  rating       Int
  comment      String     @default("")
  createdAt    DateTime   @default(now())
}
